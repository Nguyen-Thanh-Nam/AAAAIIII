{
  "name": "@pentest-harness/dsh-tool-jobs",
  "description": "Model-facing background job control tools (job_output, job_list, job_kill) over the ctx.jobs registry",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/S1N6H/pentest-harness.git",
    "directory": "packages/jobs/tool-jobs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@pentest-harness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@pentest-harness/dsh-agent": "workspace:^",
    "@pentest-harness/dsh-invariants": "workspace:^",
    "@pentest-harness/dsh-llm": "workspace:^",
    "@pentest-harness/dsh-output-retention": "workspace:^",
    "@pentest-harness/dsh-system-prompt": "workspace:^",
    "@pentest-harness/dsh-jobs": "workspace:^",
    "@pentest-harness/dsh-tools": "workspace:^",
    "@pentest-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@pentest-harness/dsh-agent": "workspace:^",
    "@pentest-harness/dsh-invariants": "workspace:^",
    "@pentest-harness/dsh-llm": "workspace:^",
    "@pentest-harness/dsh-output-retention": "workspace:^",
    "@pentest-harness/dsh-session": "workspace:^",
    "@pentest-harness/dsh-system-prompt": "workspace:^",
    "@pentest-harness/dsh-jobs": "workspace:^",
    "@pentest-harness/dsh-jobs-local": "workspace:^",
    "@pentest-harness/dsh-tools": "workspace:^",
    "@pentest-harness/cordis": "workspace:^"
  }
}
